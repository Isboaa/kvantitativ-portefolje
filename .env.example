# Environment variables for the quantitative portfolio optimizer.
# Copy this file to .env and fill in the values. Do NOT commit .env.

# Optional: API key for the market data provider (if used).
DATA_API_KEY=

# Optional: git remote URL used when output.auto_git_push is enabled.
GIT_REMOTE_URL=

# Optional: git author identity for auto-committed run history.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
